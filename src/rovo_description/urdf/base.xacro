<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_link">

    <visual>

        <origin xyz="0 0 0.10"/>

        <geometry>

            <box size="0.60 0.45 0.20"/>

        </geometry>

        <material name="blue"/>

    </visual>

    <collision>

        <origin xyz="0 0 0.10"/>

        <geometry>

            <box size="0.60 0.45 0.20"/>

        </geometry>

    </collision>

    <inertial>

        <mass value="15"/>

        <origin xyz="0 0 0.10"/>

        <inertia
            ixx="0.5"
            iyy="0.5"
            izz="0.5"
            ixy="0"
            ixz="0"
            iyz="0"/>

    </inertial>

</link>

</robot>